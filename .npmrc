# Only install dependency versions that have been on npm for at least two days.
# Compromised packages are typically caught and unpublished within a day or two,
# so sitting out that window is the cheapest supply-chain defence available to us.
# The unit is days, and it needs npm >= 11.6 (Node 24, pinned in .nvmrc, ships it).
# This filters `npm install` and `npm update`; `npm ci` still installs the
# lockfile verbatim, so CI and publishing are unaffected.
min-release-age=2
