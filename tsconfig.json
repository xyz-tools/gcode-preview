{
  "compilerOptions": {
    "declaration": false,
    "outDir": "./dist",
    "target": "es2015",
    // TypeScript 6 no longer infers a wider lib than `target` implies, but the
    // source has always relied on newer runtime APIs (Object.entries, String
    // #trimStart). Declaring them keeps the emitted target at es2015 while
    // typing against the ES2019 baseline the code actually assumes.
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    // Rolldown bundles the library, so resolution must follow bundler rules
    // rather than Node's (`node10` is removed in TypeScript 7). "bundler"
    // requires an esnext-style `module`; the output target is set separately
    // in rolldown.config.mjs.
    "module": "esnext",
    "moduleResolution": "bundler",
    "sourceMap": true,
    // TypeScript 6 turns `strict` on by default. The source is not yet
    // strictNullChecks-clean, so the old behaviour is pinned explicitly here
    // rather than silently changing what `npm run typeCheck` enforces.
    // `noImplicitAny` stays on, as it was before. Going fully strict is
    // tracked separately; tsconfig.typecheck.json already opts in for the
    // public-API type pins.
    "strict": false,
    "noImplicitAny": true,
    // Don't type-check declaration files. We compile against whichever
    // @types/three the matrix installs, and those packages carry ambient
    // declarations we neither control nor use: 0.181.0 through 0.183.1
    // reference @webgpu/types from textures/ExternalTexture.d.ts, which the
    // core index re-exports, so its GPU* globals collide with the ones
    // TypeScript 6 added to lib.dom.d.ts. Upstream dropped that reference in
    // 0.184.0, but the affected versions stay inside our supported three.js
    // range. Errors inside node_modules are not ours to fix and say nothing
    // about this source.
    "skipLibCheck": true,
    // Keep auto-inclusion to the @types/* we actually vendor or depend on.
    // This does not stop a /// <reference types="..." /> from resolving —
    // skipLibCheck above is what keeps third-party ambient types quiet.
    "typeRoots": ["types", "node_modules/@types"]
  },
  "files": ["src/gcode-preview.ts"]
}
