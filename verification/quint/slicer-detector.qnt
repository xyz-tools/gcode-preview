// -*- mode: Bluespec; -*-
/**
 * Formal specification of the slicer-detection latch (unit PA-3:
 * classification stability — a file can never change slicer mid-stream).
 *
 * Models the write-once classification latch in src/parser/gcode-parser.ts:
 * every parseGCode call, while `metadataParser` is still null, runs
 * detectSlicer (src/parser/slicer-detector.ts) over the chunk's commands.
 * detectSlicer tries the parsers in the fixed order
 * [PrusaFamily, Simplify3D, Slic3r, Cura] and returns the FIRST one whose
 * identificationPatterns (src/parser/*-parser.ts, sampled by
 * SlicerMetadataParser.canParse in src/parser/metadata-parser-base.ts)
 * match a comment. The reported name (metadata.slicerName) is resolved by
 * detectSlicerName from the latching chunk's comments only — PrusaFamily
 * upgrades to the specific family member ('PrusaSlicer', ...) when the
 * latching chunk names one, otherwise reports the generic 'PrusaFamily'.
 * Once latched, later chunks are never examined again: the classification
 * and the reported name are immutable for the life of the Parser.
 *
 * Each step observes ONE line, fed to the real Parser as its own streaming
 * chunk. The event alphabet is a distinctive marker line per supported
 * slicer (two per family, taken verbatim from the identificationPatterns)
 * plus two neutral lines that match no parser. The cmd variable records
 * which line was observed, so an ITF trace doubles as an input file: the
 * replay harness rebuilds the actual line text from a fixed event->line
 * table and feeds it to the real pipeline, comparing the detected slicer
 * after every line.
 *
 * All numeric state is integers (line counts and indices; no scaling is
 * needed). step is always enabled — an input stream can always produce
 * another line — so no explicit stutter action is required.
 */
module slicer_detector {
  // --- trace-contract variable: the line observed on this step ---
  var cmd: str

  // --- trace-contract variables: the detection latch ---
  /// Latched parser family: "none" | "PrusaFamily" | "Simplify3D" | "Slic3r" | "Cura"
  /// (mirrors Parser.metadataParser?.slicerName, "none" while null)
  var family: str
  /// Reported slicer name: "none" | "PrusaSlicer" | "PrusaFamily" | "Simplify3D" | "Slic3r" | "Cura"
  /// (mirrors Parser.metadata.slicerName, "none" while undefined)
  var detected: str
  /// 0-based index of the line whose chunk latched the detection, -1 while none
  var latchLine: int
  /// Lines observed so far (mirrors Parser.lineCount: one line per chunk)
  var linesSeen: int

  // --- history variables (not compared by the replay) ---
  // Set once at the moment of latching and never written again, so the
  // latchMonotone invariant catches any transition that would re-latch.
  var firstFamily: str
  var firstDetected: str

  pure val Families: Set[str] = Set("none", "PrusaFamily", "Simplify3D", "Slic3r", "Cura")
  pure val ReportedNames: Set[str] = Set("none", "PrusaSlicer", "PrusaFamily", "Simplify3D", "Slic3r", "Cura")

  /// Observe one line. fam/name are what detectSlicer + detectSlicerName
  /// resolve for that line when it is examined — which happens only while
  /// un-latched (the `if (!this.metadataParser)` guard in parseGCode).
  /// Neutral lines carry fam == "none" and can therefore never latch.
  action observe(ev: str, fam: str, name: str): bool = all {
    cmd' = ev,
    linesSeen' = linesSeen + 1,
    if (family == "none" and fam != "none") all {
      family' = fam,
      detected' = name,
      firstFamily' = fam,
      firstDetected' = name,
      latchLine' = linesSeen
    } else all {
      family' = family,
      detected' = detected,
      firstFamily' = firstFamily,
      firstDetected' = firstDetected,
      latchLine' = latchLine
    }
  }

  // --- one action per observable line, with the detection the source gives it ---
  // The replay keeps the matching event->line-text table; the strings named in
  // the comments below are the exact lines it feeds to the real Parser.

  /// "; generated by PrusaSlicer 2.9.2" — matches PrusaFamily's
  /// /generated by PrusaSlicer/i; detectSlicerName finds 'PrusaSlicer'.
  /// First-match priority: this line ALSO matches Slic3r's /Slic3r \d+\./i
  /// (the text contains "Slic3r 2.9."), but PrusaFamily is consulted first.
  action prusaHeader = observe("prusa_header", "PrusaFamily", "PrusaSlicer")

  /// ";LAYER_CHANGE" — the shared family dialect marker; no specific
  /// generator named, so detectSlicerName reports the generic 'PrusaFamily'.
  action prusaLayerChange = observe("prusa_layer_change", "PrusaFamily", "PrusaFamily")

  /// "; Generated by Simplify3D" — matches /Generated by Simplify3D/i
  action simplify3dHeader = observe("simplify3d_header", "Simplify3D", "Simplify3D")

  /// "; layer 1, Z = 0.300" — matches /^layer \d+, Z = [-\d.]+/i
  action simplify3dLayer = observe("simplify3d_layer", "Simplify3D", "Simplify3D")

  /// "; generated by Slic3r 1.3.0 on 2023-01-01" — matches /Generated by Slic3r/i
  action slic3rHeader = observe("slic3r_header", "Slic3r", "Slic3r")

  /// "; move to next layer (1)" — matches /^move to next layer \(\d+\)/i
  action slic3rLayer = observe("slic3r_layer", "Slic3r", "Slic3r")

  /// ";Generated with Cura_SteamEngine 5.0" — matches /Cura_SteamEngine/i
  action curaHeader = observe("cura_header", "Cura", "Cura")

  /// ";LAYER:0" — matches Cura's /^LAYER:\d+/ (and no earlier parser)
  action curaLayer = observe("cura_layer", "Cura", "Cura")

  /// "; just a boring comment" — a comment matching no identificationPattern
  action neutralComment = observe("neutral_comment", "none", "none")

  /// "G1 X10 Y5" — a command line with no comment at all; detectSlicer
  /// filters it out before any pattern runs
  action neutralMove = observe("neutral_move", "none", "none")

  // --- init and step ---

  action init = all {
    cmd' = "init",
    family' = "none",
    detected' = "none",
    firstFamily' = "none",
    firstDetected' = "none",
    latchLine' = -1,
    linesSeen' = 0
  }

  action anyMarker = any {
    prusaHeader, prusaLayerChange,
    simplify3dHeader, simplify3dLayer,
    slic3rHeader, slic3rLayer,
    curaHeader, curaLayer
  }

  action anyNeutral = any { neutralComment, neutralMove }

  /// Weighted line pick: 40% neutral so some traces delay the latch, the
  /// rest markers so every trace showers the latch with conflicting
  /// evidence after it is set. Always enabled.
  action step = {
    nondet choice = 1.to(10).oneOf()
    if (choice <= 4) anyNeutral else anyMarker
  }

  // --- invariants ---

  val domainsOk = and {
    Families.contains(family),
    ReportedNames.contains(detected),
    Families.contains(firstFamily),
    ReportedNames.contains(firstDetected)
  }

  /// The latch is monotone: the current classification always equals the
  /// first one ever taken, so once latched it can never change — regardless
  /// of which markers arrive later.
  val latchMonotone = and {
    family == firstFamily,
    detected == firstDetected
  }

  /// The parser latch and the reported name are set together, never separately
  val unlatchedConsistent = (family == "none") iff (detected == "none")

  /// The reported name always belongs to the latched family: only
  /// PrusaFamily resolves to a more specific generator name.
  val familyNameConsistent = and {
    family == "PrusaFamily" implies Set("PrusaSlicer", "PrusaFamily").contains(detected),
    family == "Simplify3D" implies detected == "Simplify3D",
    family == "Slic3r" implies detected == "Slic3r",
    family == "Cura" implies detected == "Cura"
  }

  /// latchLine is -1 exactly while un-latched, and otherwise names a line
  /// that has actually been observed
  val latchLineConsistent = and {
    linesSeen >= 0,
    if (family == "none") latchLine == -1 else (latchLine >= 0 and latchLine < linesSeen)
  }

  val allInvariants = and {
    domainsOk,
    latchMonotone,
    unlatchedConsistent,
    familyNameConsistent,
    latchLineConsistent
  }

  // --- semantic tests (run with: npx quint test verification/quint/slicer-detector.qnt) ---

  /// The PrusaSlicer header latches PrusaFamily with the specific name, and a
  /// later Slic3r header cannot re-latch — even though the Prusa header line
  /// itself also matches Slic3r's /Slic3r \d+\./i pattern (first-match priority).
  run prusaHeaderPriorityTest =
    init
      .then(prusaHeader)
      .expect(and { family == "PrusaFamily", detected == "PrusaSlicer", latchLine == 0 })
      .then(slic3rHeader)
      .expect(and { family == "PrusaFamily", detected == "PrusaSlicer", latchLine == 0, linesSeen == 2 })

  /// Cura latches from its layer marker after a neutral line, and later
  /// PrusaFamily markers — a higher-priority family in detectSlicer's order —
  /// never re-latch: priority applies within one detection attempt, while the
  /// stream latch is strictly first-come.
  run curaLatchStableTest =
    init
      .then(neutralComment)
      .expect(and { family == "none", detected == "none", latchLine == -1 })
      .then(curaLayer)
      .expect(and { family == "Cura", detected == "Cura", latchLine == 1 })
      .then(prusaLayerChange)
      .expect(and { family == "Cura", detected == "Cura" })
      .then(prusaHeader)
      .expect(and { family == "Cura", detected == "Cura", latchLine == 1, linesSeen == 4 })

  /// Simplify3D latches from its per-layer comment; a later Cura header
  /// does not change the classification.
  run simplify3dLatchTest =
    init
      .then(simplify3dLayer)
      .expect(and { family == "Simplify3D", detected == "Simplify3D", latchLine == 0 })
      .then(curaHeader)
      .expect(and { family == "Simplify3D", detected == "Simplify3D", latchLine == 0 })

  /// Slic3r latches from its layer marker after a comment-less move line;
  /// a later PrusaSlicer header does not change the classification.
  run slic3rLatchTest =
    init
      .then(neutralMove)
      .expect(family == "none")
      .then(slic3rLayer)
      .expect(and { family == "Slic3r", detected == "Slic3r", latchLine == 1 })
      .then(prusaHeader)
      .expect(and { family == "Slic3r", detected == "Slic3r" })

  /// Neutral lines never latch anything, however many arrive
  run neutralNeverLatchesTest =
    init
      .then(neutralComment)
      .then(neutralMove)
      .then(neutralComment)
      .then(neutralMove)
      .expect(and { family == "none", detected == "none", latchLine == -1, linesSeen == 4 })

  /// The reported name is resolved from the latching chunk only: latching on
  /// the generic LAYER_CHANGE dialect reports 'PrusaFamily', and a later
  /// header naming PrusaSlicer never upgrades the name.
  run genericFamilyNameStickyTest =
    init
      .then(prusaLayerChange)
      .expect(and { family == "PrusaFamily", detected == "PrusaFamily" })
      .then(prusaHeader)
      .expect(and { family == "PrusaFamily", detected == "PrusaFamily", latchLine == 0 })
}
