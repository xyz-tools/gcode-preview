{
  "name": "gcode-preview",
  "version": "3.0.0-alpha.6",
  "description": "Preview a 3d print from a gcode file",
  "author": "remcoder@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyz-tools/gcode-preview.git"
  },
  "homepage": "https://gcode-preview.web.app/",
  "main": "dist/gcode-preview.es.js",
  "files": [
    "dist"
  ],
  "types": "dist/gcode-preview.d.ts",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^24.13.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.64",
    "concurrently": "^9.2.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "happy-dom": "^20.14.3",
    "lil-gui": "^0.20.0",
    "live-server": "^1.2.1 <1.2.2",
    "prettier": "^3.6.2",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "~6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "dev": "concurrently -n BUILD,SERVER -c bold.white.bgGreen,bold.white.bgBlue 'npm run dev:watch' 'npm run live-server'",
    "dev:build": "export NODE_ENV=development; rollup -c",
    "dev:watch": "export NODE_ENV=development; rollup -c -w",
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "demo": "npm run build && npm run live-server",
    "live-server": "live-server demo --watch=.,js,../dist --mount=/lib:node_modules --mount=/dist:dist",
    "typeCheck": "tsc --noEmit",
    "lint": "prettier --check . && eslint -c .eslintrc.cjs .",
    "lint:fix": "npm run prettier:fix && npm run eslint:fix",
    "eslint:fix": "eslint -c .eslintrc.cjs . --fix",
    "prettier:fix": "prettier --plugin-search-dir . --write .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest --watch",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "preversion": "npm run typeCheck && npm run test:coverage && npm run lint",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:alpha": "npm version prerelease --preid=alpha",
    "predeploy": "npm run build && npm run copy-deps && npm run copy-dist",
    "copy-deps": "copyfiles -f node_modules/three/build/three.module.min.js demo/lib/three/build && copyfiles -f node_modules/three/build/three.core.min.js demo/lib/three/build",
    "copy-dist": "copyfiles -u 1 \"dist/**/*.js\" demo/dist",
    "deploy:preview": "live-server demo",
    "typedoc": "typedoc",
    "typedoc:watch": "typedoc --watch",
    "check": "npm run test && npm run typeCheck && npm run lint && echo '😅 All checks passed!'",
    "evals": "node --no-warnings --experimental-strip-types evals/run.ts",
    "evals:grade": "node --no-warnings --experimental-strip-types evals/grade.ts",
    "test:packaging": "npm run build && node scripts/test-packaging.mjs"
  },
  "dependencies": {
    "three": ">=0.166.0 <0.186.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/gcode-preview.d.ts",
      "import": "./dist/gcode-preview.es.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
